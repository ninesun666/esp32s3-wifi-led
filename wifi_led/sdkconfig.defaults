CONFIG_IDF_TARGET="esp32s3"

# Credentials are NOT here. They live in sdkconfig.local (gitignored), merged
# via SDKCONFIG_DEFAULTS in CMakeLists.txt. Delete sdkconfig after editing.

# --- Match the N16R8 module: 16MB flash ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- Match the N16R8 module: 8MB Octal PSRAM @ 80MHz ---
# R8 means Octal, NOT Quad. Wrong setting boots but PSRAM init fails.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# --- OTA-ready layout (otadata + two app slots) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# New slot starts in "pending verify": app_main marks it valid after a clean
# boot, and the bootloader falls back to the old slot if it crashes first.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Board pins and endpoints (see main/Kconfig.projbuild) ---
CONFIG_WIFI_LED_RGB_GPIO=48
CONFIG_WIFI_LED_RGB_COUNT=1
CONFIG_WIFI_LED_MONO_GPIO=-1
CONFIG_WIFI_LED_HTTP_PORT=80
CONFIG_WIFI_LED_MDNS_HOSTNAME="esp32-monitor"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- BLE (NimBLE host; ESP32-S3 has no classic Bluetooth) ---
# Toggle lives in main/Kconfig.projbuild. Any change here or to the toggle
# needs "rm sdkconfig" before build, or nothing takes effect.
CONFIG_EXAMPLE_BLE_ENABLE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# One phone at a time; advertising resumes on disconnect.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Status JSON is ~300 bytes; 512 MTU lets a single ATT read carry it.
# Android negotiates 512/517; iOS caps lower (~185) and falls back to
# long reads, which the NimBLE server handles automatically.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
# NimBLE host pools in PSRAM; internal RAM stays for Wi-Fi/controller.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# Access callbacks run in this task and build the status JSON on its stack.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4608
# Peripheral only: trim unused roles.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# Trim default-on GATT services this project does not implement.
CONFIG_BT_NIMBLE_PROX_SERVICE=n
CONFIG_BT_NIMBLE_ANS_SERVICE=n
CONFIG_BT_NIMBLE_CTS_SERVICE=n
CONFIG_BT_NIMBLE_HTP_SERVICE=n
CONFIG_BT_NIMBLE_IPSS_SERVICE=n
CONFIG_BT_NIMBLE_TPS_SERVICE=n
CONFIG_BT_NIMBLE_IAS_SERVICE=n
CONFIG_BT_NIMBLE_LLS_SERVICE=n
CONFIG_BT_NIMBLE_SPS_SERVICE=n
CONFIG_BT_NIMBLE_HR_SERVICE=n
CONFIG_BT_NIMBLE_BAS_SERVICE=n
CONFIG_BT_NIMBLE_DIS_SERVICE=n

# --- esp_emote asset pack (CONFIG_WIFI_LED_TFT_EMOTE_ENABLE) ---
# The asset index is built with 32-character names; if the runtime is compiled with
# a different MMAP_FILE_NAME_LENGTH the pack loads with truncated/missing entries.
CONFIG_MMAP_FILE_NAME_LENGTH=32
# The 20px PuHuiCJK face font has far more than 8192 glyphs, which LVGL only
# allows with the large text-format turned on.
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# display_tft_start() mounts and parses a 2.4 MB asset pack on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
